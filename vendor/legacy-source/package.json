{
  "name": "web3-agent-lab",
  "version": "0.1.3",
  "displayVersion": "V0.13",
  "releaseRevision": "beta-1",
  "releaseLabel": "V0.13",
  "private": true,
  "type": "module",
  "description": "Local reproducible Web3 agent experiments with Anvil and a browser GUI",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node scripts/compile-contracts.mjs && node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "dev": "node --import ./scripts/register-agentkit.mjs --import tsx src/server.ts",
    "test": "node --import ./scripts/register-agentkit.mjs --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "examples": "node scripts/examples.mjs"
  },
  "dependencies": {
    "@coinbase/agentkit": "0.10.4",
    "@langchain/langgraph": "1.4.18",
    "@langchain/core": "1.2.12",
    "viem": "2.38.3",
    "zod": "3.25.76",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "esbuild": "0.28.2",
    "solc": "0.8.30"
  }
}
