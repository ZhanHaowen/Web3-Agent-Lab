{
  "name": "web3-agent-lab",
  "version": "0.17.0-beta.1",
  "displayVersion": "V0.17.0 Research Beta",
  "releaseRevision": "payment-trace-research-beta",
  "releaseLabel": "V0.17.0 Research Beta",
  "private": true,
  "type": "module",
  "description": "Reproducible Web3 Agent experiments, local/API models, payment traces and private-ground-truth inference evaluation",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node scripts/bundle-research-deps.mjs && node scripts/compile-peer.mjs && node scripts/compile-research-payments.mjs && node scripts/compile-research-job.mjs && node scripts/build-legacy.mjs && node scripts/build-v014.mjs",
    "setup:research": "pnpm --dir packages/payment-adapters install --frozen-lockfile --ignore-workspace",
    "research": "node scripts/research-cli.mjs",
    "test:research": "node --test tests/research-*.test.mjs",
    "test:research:chain": "node tests/research-payments.mjs && node tests/research-payments-mpp.mjs && node tests/research-payments-adversarial.mjs && node tests/research-escrow.mjs && node tests/research-integration.mjs",
    "build:legacy": "node scripts/build-legacy.mjs",
    "setup:local-model": "node scripts/setup-local-model.mjs",
    "start": "node dist/server.mjs",
    "dev": "node --watch dist/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.control.json --noEmit",
    "examples": "node scripts/examples.mjs",
    "test:peer-chain": "node tests/peer-contract.mjs",
    "test:peer-api": "node tests/peer-integration.mjs",
    "build:budget": "node scripts/compile-budget.mjs",
    "test:budget": "node tests/budget-integration.mjs",
    "start:budget": "node dist/server.mjs",
    "test:budget:main": "node tests/budget-main-integration.mjs",
    "dev:budget-harness": "node src/budget/server.mjs",
    "typecheck:interfaces": "tsc -p tsconfig.control.json --noEmit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:budget:matrix": "node tests/budget-parameter-matrix.mjs",
    "test:budget:http": "node tests/budget-http.mjs",
    "test:budget:launcher": "node tests/budget-launcher.mjs",
    "test:service": "node tests/service-integration.mjs",
    "build:base-contracts": "node scripts/compile-contracts.mjs",
    "package:windows": "python scripts/package-budget.py",
    "test:v2": "node tests/v2-integration.mjs"
  },
  "dependencies": {
    "@coinbase/agentkit": "0.10.4",
    "@langchain/langgraph": "1.4.18",
    "@langchain/core": "1.2.12",
    "viem": "2.38.3",
    "zod": "3.25.76",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "esbuild": "0.28.2",
    "solc": "0.8.30"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhanHaowen/Web3-Agent-Lab.git"
  }
}
